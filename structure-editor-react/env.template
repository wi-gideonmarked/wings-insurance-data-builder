# ===========================================
# Database Configuration (for RDS mode)
# ===========================================

# PostgreSQL RDS Connection
PGHOST=your-rds-endpoint.us-east-1.rds.amazonaws.com
PGPORT=5432
PGUSER=your_username
PGPASSWORD=your_password
PGDATABASE=wings_insurance
PGSSL=true

# ===========================================
# API Server Configuration
# ===========================================

# Port for the RDS API server
API_PORT=4000

# Authentication token for API requests
# Generate a secure token: openssl rand -hex 32
API_AUTH_TOKEN=your-secret-auth-token-here

# ===========================================
# Frontend Configuration
# ===========================================

# Data Source: 'local' for JSON files, 'rds' for database
# Default is 'local' - change to 'rds' to enable RDS mode
VITE_DATA_SOURCE=local

# RDS API URL (when using RDS mode)
VITE_RDS_API_URL=http://localhost:4000

# RDS Auth Token (must match API_AUTH_TOKEN above)
VITE_RDS_AUTH_TOKEN=your-secret-auth-token-here

# ===========================================
# Export Configuration
# ===========================================

# Directory for exporting separated JSON files
DEST_DIR=public/separated

# JSON file for bulk import
JSON_FILE=makes-models.json

