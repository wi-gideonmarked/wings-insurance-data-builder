{
  "name": "structure-editor-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prebuild": "node ./scripts/export-from-db.mjs && npm run sync:public",
    "dev": "concurrently \"npm run api:rds\" \"npm run dev:frontend\" --names \"API,Frontend\" --prefix-colors \"blue,green\"",
    "dev:frontend": "node ./scripts/export-from-db.mjs && vite",
    "dev:local": "node ./scripts/export-from-db.mjs && vite",
    "build": "tsc -b && node ./scripts/export-from-db.mjs && vite build",
    "postbuild": "npm run sync:dist",
    "lint": "eslint .",
    "preview": "vite preview",
    "update:separated": "node scripts/update-separated-from-csv.mjs",
    "start": "npm run build && npx pm2 serve dist 80 --name structure-editor-react --spa",
    "serve": "serve -s dist -l 80",
    "pm2:start": "npx pm2 serve dist 80 --name structure-editor-react --spa",
    "api:start": "node ./scripts/local-api.mjs",
    "api:rds": "node ./scripts/rds-api-server.mjs",
    "db:test": "node ./scripts/db-connector.mjs",
    "db:init": "node ./scripts/db-init.mjs",
    "db:import-separated": "node ./scripts/import-separated.mjs",
    "db:list:tables": "node ./scripts/list-tables.mjs",
    "db:schema:create": "node ./scripts/create-schema.mjs",
    "db:import:makes-models": "node ./scripts/import-makes-models.mjs",
    "db:import:json": "node ./scripts/import-makes-models-json.mjs",
    "db:view:makes": "node ./scripts/view-makes.mjs",
    "db:view:models": "node ./scripts/view-models.mjs",
    "db:upgrade:makes": "node ./scripts/upgrade-makes-table.mjs",
    "db:upgrade:models": "node ./scripts/upgrade-models-table.mjs",
    "db:upgrade:models-sf": "node ./scripts/upgrade-models-sf-fields.mjs",
    "db:upgrade:all": "npm run db:upgrade:makes && npm run db:upgrade:models",
    "db:schema:flexible": "node ./scripts/create-flexible-schema.mjs",
    "db:schema:reset": "node ./scripts/reset-schema.mjs",
    "db:migrate:flexible": "node ./scripts/migrate-to-flexible-schema.mjs",
    "db:setup:flexible": "node ./scripts/setup-flexible-schema.mjs",
    "db:view:models-with-providers": "node ./scripts/view-models-with-providers.mjs",
    "db:list:providers": "node ./scripts/list-providers.mjs",
    "db:add:provider": "node ./scripts/add-provider.mjs",
    "db:remove:salesforce": "node ./scripts/remove-salesforce-provider.mjs",
    "db:add:make": "node ./scripts/add-make.mjs",
    "db:export:flexible": "node ./scripts/export-from-flexible-schema.mjs",
    "pm2:probe:start": "npx pm2 start ecosystem.config.js --only structure-editor-probe",
    "pm2:probe:stop": "npx pm2 stop structure-editor-probe || true && npx pm2 delete structure-editor-probe || true",
    "diagnose": "bash ./scripts/diagnose.sh",
    "sync:public": "mkdir -p public/separated && cp -afv separated/*.json public/separated/",
    "sync:dist": "mkdir -p dist/separated && cp -afv public/separated/*.json dist/separated/",
    "pm2:stop": "npx pm2 stop structure-editor-react",
    "pm2:restart": "npx pm2 restart structure-editor-react",
    "pm2:delete": "npx pm2 delete structure-editor-react",
    "pm2:logs": "npx pm2 logs structure-editor-react",
    "pm2:status": "npx pm2 status",
    "docs:build": "node ./scripts/build-docs.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11",
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "pg": "^8.13.0",
    "csv-parse": "^5.6.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.1.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "pm2": "^5.3.0",
    "dotenv": "^16.4.5",
    "serve": "^14.2.1",
    "terser": "^5.27.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7",
    "marked": "^13.0.2",
    "html-docx-js": "^0.3.1"
  }
}
