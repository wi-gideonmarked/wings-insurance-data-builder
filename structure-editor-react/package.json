{
  "name": "structure-editor-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "update:separated": "node scripts/update-separated-from-csv.mjs",
    "start": "npm run build && npx pm2 serve dist 3000 --name structure-editor-react --spa",
    "serve": "serve -s dist -l 3000",
    "pm2:start": "npx pm2 serve dist 3000 --name structure-editor-react --spa",
    "pm2:stop": "npx pm2 stop structure-editor-react",
    "pm2:restart": "npx pm2 restart structure-editor-react",
    "pm2:delete": "npx pm2 delete structure-editor-react",
    "pm2:logs": "npx pm2 logs structure-editor-react",
    "pm2:status": "npx pm2 status"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11",
    "csv-parse": "^5.6.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "pm2": "^5.3.0",
    "serve": "^14.2.1",
    "terser": "^5.27.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7"
  }
}
